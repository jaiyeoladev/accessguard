# --- Microsoft Entra app registration (read-only) ---------------------------
# Leave these blank to use demo mode only. See docs/entra-setup.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Use EITHER a client secret OR a certificate (certificate recommended).
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERT_PATH=
AZURE_CLIENT_CERT_THUMBPRINT=

# --- Storage ----------------------------------------------------------------
# Holds scan snapshots (your directory data) — keep it private.
ACCESSGUARD_DATA_DIR=./data

# --- Web dashboard ----------------------------------------------------------
# Required when the dashboard listens on anything other than localhost (e.g. Docker).
ACCESSGUARD_UI_USERNAME=admin
ACCESSGUARD_UI_PASSWORD=

# --- Rule thresholds (optional) ---------------------------------------------
ACCESSGUARD_DORMANT_DAYS=90
ACCESSGUARD_NEVER_SIGNED_IN_GRACE_DAYS=30
ACCESSGUARD_CREDENTIAL_EXPIRY_WARNING_DAYS=30
ACCESSGUARD_MAX_SECRET_LIFETIME_DAYS=365
ACCESSGUARD_MAX_GLOBAL_ADMINS=4
ACCESSGUARD_ANOMALY_THRESHOLD=3.5

# Comma-separated words that mark a service principal as a possible AI agent.
# ACCESSGUARD_AGENT_KEYWORDS=agent,copilot,gpt,openai,llm,chatbot,bot,ai,claude,gemini,anthropic,assistant
